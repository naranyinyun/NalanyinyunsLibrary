---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { getBannerMonetTheme } from "../utils/monet-theme";
import { pathsEqual, url } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const monetTheme = await getBannerMonetTheme(
	banner,
	siteConfig.themeColor.monet,
);
const monetEnabled = Boolean(monetTheme);
const configHue = monetTheme?.hue ?? siteConfig.themeColor.hue;
const themeColorFixed = siteConfig.themeColor.fixed;
const themeColorLight = monetTheme?.themeColorLight ?? "#ffffff";
const themeColorDark = monetTheme?.themeColorDark ?? "#161618";

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	  data-monet-theme={monetTheme ? monetTheme.variant : undefined}
	  data-overlayscrollbars-initialize
	>
	<head>
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content={themeColorLight} />


		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue, themeColorFixed, monetEnabled, themeColorLight, themeColorDark}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Sync browser theme-color meta tag
			const themeColorMeta = document.querySelector('meta[name="theme-color"]');
			if (themeColorMeta) {
				const isDark = document.documentElement.classList.contains('dark');
				themeColorMeta.setAttribute('content', isDark ? themeColorDark : themeColorLight);
			}

			// Load the hue from local storage unless themeColor is fixed or Monet is active
			const hue = (themeColorFixed || monetEnabled) ? configHue : (localStorage.getItem('hue') || configHue);
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->
		{monetTheme && <style is:inline set:html={monetTheme.css} />}


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
		<Analytics />

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<div id="initial-loader" role="status" aria-label="正在加载页面">
			<div class="loader-stage">
				<div class="loader-seal" aria-hidden="true">
					<svg class="loader-ring" viewBox="0 0 72 72" fill="none">
						<circle class="loader-ring-track" cx="36" cy="36" r="32" stroke-width="2" />
						<circle class="loader-ring-arc" cx="36" cy="36" r="32" stroke-width="2.25" stroke-linecap="round" />
					</svg>
					<div class="loader-emblem">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 6.5c-2.2-1.5-5-2-8-1.5v13c3-.5 5.8 0 8 1.5" />
							<path d="M12 6.5c2.2-1.5 5-2 8-1.5v13c-3-.5-5.8 0-8 1.5" />
							<path d="M12 6.5v13" />
						</svg>
					</div>
				</div>
				<div class="loader-brand">
					<span class="loader-title">{siteConfig.title}</span>
					<span class="loader-subtitle">{siteConfig.subtitle}</span>
				</div>
			</div>
		</div>
		<div id="m3-nav-progress" aria-hidden="true">
			<span class="m3-nav-progress-bar"></span>
		</div>
		<div id="pwa-update-toast" role="region" aria-live="polite" aria-label="网站更新" hidden>
			<div class="pwa-update-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
					<path d="M3 3v5h5" />
					<path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
					<path d="M16 16h5v5" />
				</svg>
			</div>
			<div class="pwa-update-copy">
				<strong>发现新版本</strong>
				<span>刷新即可获取最新内容</span>
			</div>
			<div class="pwa-update-actions">
				<button id="pwa-update-button" type="button">刷新</button>
				<button id="pwa-update-dismiss" type="button" aria-label="稍后更新" title="稍后">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M18 6 6 18" />
						<path d="m6 6 12 12" />
					</svg>
				</button>
			</div>
		</div>
		<ConfigCarrier
			hue={configHue}
			themeColorLight={themeColorLight}
			themeColorDark={themeColorDark}
		></ConfigCarrier>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
		<SpeedInsights />
	</body>
</html>

<script>
	import { registerSW } from "virtual:pwa-register";

	const loader = document.getElementById("initial-loader");
	let loaderHidden = false;
	const hideLoader = () => {
		if (loaderHidden || !loader) return;
		loaderHidden = true;
		loader.classList.add("is-hidden");
		window.setTimeout(() => loader.remove(), 460);
	};

	if (document.readyState === "complete") {
		hideLoader();
	} else {
		window.addEventListener("load", hideLoader, { once: true });
		window.setTimeout(hideLoader, 8000);
	}

	const updateToast = document.getElementById("pwa-update-toast");
	const updateButton = document.getElementById("pwa-update-button");
	const dismissButton = document.getElementById("pwa-update-dismiss");

	const updateSW = registerSW({
		immediate: true,
		onNeedRefresh() {
			updateToast?.classList.remove("is-dismissing");
			updateToast?.removeAttribute("hidden");
		},
		onRegisteredSW(_swScriptUrl, registration) {
			registration?.update();
		},
		onRegisterError(error) {
			console.error("Unable to register the offline cache", error);
		},
	});

	updateButton?.addEventListener("click", () => {
		updateButton.setAttribute("disabled", "true");
		updateButton.textContent = "更新中…";
		void updateSW(true);
	});
	dismissButton?.addEventListener("click", () => {
		if (!updateToast || updateToast.hasAttribute("hidden")) return;
		updateToast.classList.add("is-dismissing");
		window.setTimeout(() => {
			updateToast.setAttribute("hidden", "true");
			updateToast.classList.remove("is-dismissing");
		}, 200);
	});
</script>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
html:has(#initial-loader:not(.is-hidden)) {
	background: var(--page-bg, #f8f7fa);
}
#initial-loader {
	--_bg: var(--md-sys-color-surface, var(--page-bg, #f8f7fa));
	--_on-surface: var(--md-sys-color-on-surface, #1d1b20);
	--_primary: var(--md-sys-color-primary, var(--primary, #6750a4));
	--_primary-container: var(--md-sys-color-primary-container, var(--btn-regular-bg, #eaddff));
	--_on-primary-container: var(--md-sys-color-on-primary-container, var(--btn-content, #21005d));
	--_outline: var(--md-sys-color-outline-variant, var(--line-divider, rgb(0 0 0 / 10%)));
	position: fixed;
	inset: 0;
	z-index: 10000;
	display: grid;
	place-items: center;
	background: var(--_bg);
	opacity: 1;
	transition: opacity 420ms cubic-bezier(.2, .8, .2, 1), backdrop-filter 420ms cubic-bezier(.2, .8, .2, 1);
}
:root.dark #initial-loader {
	--_on-surface: var(--md-sys-color-on-surface, #e6e0e9);
}
#initial-loader.is-hidden {
	opacity: 0;
	backdrop-filter: blur(8px);
	pointer-events: none;
}
.loader-stage {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 1.125rem;
	animation: loader-stage-enter 400ms cubic-bezier(.05, .7, .1, 1) both;
	transition: transform 380ms cubic-bezier(.2, .8, .2, 1), opacity 320ms ease;
}
#initial-loader.is-hidden .loader-stage {
	opacity: 0;
	transform: translateY(-10px) scale(1.04);
}
.loader-seal {
	position: relative;
	display: grid;
	place-items: center;
	width: 72px;
	height: 72px;
}
.loader-ring {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	animation: loader-ring-spin 2.2s linear infinite;
}
.loader-ring-track {
	stroke: color-mix(in srgb, var(--_outline) 70%, transparent);
}
.loader-ring-arc {
	stroke: var(--_primary);
	stroke-dasharray: 70 201;
	animation: loader-arc-breathe 1.6s cubic-bezier(.4, 0, .2, 1) infinite;
}
.loader-emblem {
	display: grid;
	place-items: center;
	width: 48px;
	height: 48px;
	border-radius: 1rem;
	background: var(--_primary-container);
	color: var(--_on-primary-container);
	box-shadow: 0 2px 10px color-mix(in srgb, var(--_primary) 14%, transparent);
	animation: loader-emblem-float 2.4s ease-in-out infinite;
}
.loader-brand {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: .25rem;
	text-align: center;
}
.loader-title {
	color: var(--_on-surface);
	font-size: .9375rem;
	font-weight: 600;
	letter-spacing: .04em;
}
.loader-subtitle {
	color: color-mix(in srgb, var(--_on-surface) 60%, transparent);
	font-size: .75rem;
	letter-spacing: .12em;
}
@keyframes loader-stage-enter {
	from { opacity: 0; transform: translateY(8px) scale(.97); }
	to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes loader-ring-spin {
	to { transform: rotate(360deg); }
}
@keyframes loader-arc-breathe {
	0%, 100% { stroke-dasharray: 46 201; stroke-dashoffset: 0; }
	50% { stroke-dasharray: 112 201; stroke-dashoffset: -36; }
}
@keyframes loader-emblem-float {
	0%, 100% { transform: scale(1); }
	50% { transform: scale(1.04); }
}
#m3-nav-progress {
	--_primary: var(--md-sys-color-primary, var(--primary, #6750a4));
	--_tertiary: var(--md-sys-color-tertiary, var(--_primary));
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	z-index: 9990;
	height: 3px;
	overflow: hidden;
	pointer-events: none;
	opacity: 0;
	background: color-mix(in srgb, var(--_primary) 14%, transparent);
	transition: opacity 220ms cubic-bezier(.2, 0, 0, 1);
}
#m3-nav-progress.is-active {
	opacity: 1;
}
.m3-nav-progress-bar {
	position: absolute;
	inset: 0 auto 0 0;
	width: 55%;
	border-radius: 999px;
	background: linear-gradient(
		90deg,
		transparent 0%,
		color-mix(in srgb, var(--_primary) 55%, transparent) 20%,
		var(--_primary) 50%,
		var(--_tertiary) 80%,
		transparent 100%
	);
	box-shadow: 0 0 10px color-mix(in srgb, var(--_primary) 45%, transparent);
	transform: translateX(-100%);
}
#m3-nav-progress.is-active .m3-nav-progress-bar {
	animation: m3-nav-shimmer 1.15s cubic-bezier(.4, 0, .2, 1) infinite;
}
#m3-nav-progress.is-finishing {
	opacity: 0;
	transition: opacity 260ms ease 120ms;
}
#m3-nav-progress.is-finishing .m3-nav-progress-bar {
	width: 100%;
	animation: none;
	transform: translateX(0);
	transition: width 180ms cubic-bezier(.2, 0, 0, 1), transform 180ms cubic-bezier(.2, 0, 0, 1);
}
@keyframes m3-nav-shimmer {
	0% { transform: translateX(-100%); }
	100% { transform: translateX(220%); }
}
#pwa-update-toast {
	--_surface: var(--md-sys-color-surface-container, var(--float-panel-bg, var(--card-bg, #f3edf7)));
	--_on-surface: var(--md-sys-color-on-surface, #1d1b20);
	--_primary: var(--md-sys-color-primary, var(--primary, #6750a4));
	--_on-primary: var(--md-sys-color-on-primary, #ffffff);
	--_primary-container: var(--md-sys-color-primary-container, var(--btn-regular-bg, #eaddff));
	--_on-primary-container: var(--md-sys-color-on-primary-container, var(--btn-content, #21005d));
	--_outline: var(--md-sys-color-outline-variant, var(--line-divider, rgb(0 0 0 / 12%)));
	position: fixed;
	right: 1.5rem;
	bottom: calc(1.5rem + env(safe-area-inset-bottom));
	z-index: 90;
	display: flex;
	align-items: center;
	gap: .75rem;
	width: max-content;
	max-width: min(23.5rem, calc(100vw - 2rem));
	padding: .625rem .625rem .625rem .75rem;
	border: 1px solid color-mix(in srgb, var(--_outline) 75%, transparent);
	border-radius: 1rem;
	background: color-mix(in srgb, var(--_surface) 90%, transparent);
	backdrop-filter: blur(16px) saturate(1.2);
	-webkit-backdrop-filter: blur(16px) saturate(1.2);
	color: var(--_on-surface);
	box-shadow:
		0 4px 12px rgb(0 0 0 / 8%),
		0 1px 3px rgb(0 0 0 / 6%);
	animation: update-snackbar-enter 320ms cubic-bezier(.05, .7, .1, 1) both;
	transition: opacity 200ms cubic-bezier(.3, 0, .8, .15), transform 200ms cubic-bezier(.3, 0, .8, .15);
}
:root.dark #pwa-update-toast {
	--_on-surface: var(--md-sys-color-on-surface, #e6e0e9);
	box-shadow:
		0 6px 20px rgb(0 0 0 / 28%),
		0 1px 4px rgb(0 0 0 / 18%);
}
#pwa-update-toast[hidden] { display: none; }
#pwa-update-toast.is-dismissing {
	opacity: 0;
	transform: translateY(10px) scale(.97);
	pointer-events: none;
}
.pwa-update-icon {
	display: grid;
	place-items: center;
	flex-shrink: 0;
	width: 2.25rem;
	height: 2.25rem;
	border-radius: .75rem;
	background: var(--_primary-container);
	color: var(--_on-primary-container);
}
.pwa-update-copy {
	display: grid;
	gap: .0625rem;
	min-width: 0;
	margin-right: .25rem;
}
.pwa-update-copy strong {
	font-size: .875rem;
	font-weight: 600;
	line-height: 1.3;
}
.pwa-update-copy span {
	color: color-mix(in srgb, var(--_on-surface) 68%, transparent);
	font-size: .75rem;
	line-height: 1.35;
}
.pwa-update-actions {
	display: flex;
	align-items: center;
	gap: .25rem;
	flex-shrink: 0;
}
#pwa-update-button {
	height: 2.125rem;
	padding: 0 .875rem;
	border: 0;
	border-radius: 999px;
	background: var(--_primary);
	color: var(--_on-primary);
	font-size: .8125rem;
	font-weight: 600;
	letter-spacing: .01em;
	cursor: pointer;
	transition: filter 150ms ease, transform 150ms cubic-bezier(.2, 0, 0, 1);
}
#pwa-update-button:hover:not(:disabled) { filter: brightness(1.07); }
#pwa-update-button:active:not(:disabled) { transform: scale(.96); }
#pwa-update-button:disabled { opacity: .65; cursor: wait; }
#pwa-update-dismiss {
	display: grid;
	place-items: center;
	width: 2rem;
	height: 2rem;
	padding: 0;
	border: 0;
	border-radius: 999px;
	background: transparent;
	color: color-mix(in srgb, var(--_on-surface) 65%, transparent);
	cursor: pointer;
	transition: background-color 150ms ease, color 150ms ease, transform 150ms cubic-bezier(.2, 0, 0, 1);
}
#pwa-update-dismiss:hover {
	background: color-mix(in srgb, var(--_on-surface) 8%, transparent);
	color: var(--_on-surface);
}
#pwa-update-dismiss:active { transform: scale(.92); }
#pwa-update-button:focus-visible,
#pwa-update-dismiss:focus-visible {
	outline: 2px solid var(--_primary);
	outline-offset: 2px;
}
@media (max-width: 640px) {
	#pwa-update-toast {
		left: 1rem;
		right: 1rem;
		bottom: calc(1rem + env(safe-area-inset-bottom));
		width: auto;
		max-width: none;
	}
	.pwa-update-copy { flex: 1; }
}
@media (prefers-reduced-motion: reduce) {
	.loader-stage,
	.loader-ring,
	.loader-ring-arc,
	.loader-emblem,
	.m3-nav-progress-bar,
	#pwa-update-toast {
		animation: none;
		transition: none;
	}
}
@keyframes update-snackbar-enter {
	from {
		opacity: 0;
		transform: translateY(14px) scale(.96);
	}
	to {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
}

@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script>
import 'overlayscrollbars/overlayscrollbars.css';
import {
	OverlayScrollbars,
	// ScrollbarsHidingPlugin,
	// SizeObserverPlugin,
	// ClickScrollPlugin
} from 'overlayscrollbars';
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import {pathsEqual, url} from "../utils/url-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';

