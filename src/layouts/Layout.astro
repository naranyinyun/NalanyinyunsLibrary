}
#pwa-update-toast {
	position: fixed;
	left: 50%;
	bottom: 0;
	z-index: 9999;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1.5rem;
	width: min(44rem, 100vw);
	padding: 1.25rem 1.5rem calc(1.25rem + env(safe-area-inset-bottom));
	border: 1px solid color-mix(in srgb, var(--primary, #6750a4) 18%, transparent);
	border-bottom: 0;
	border-radius: 1.5rem 1.5rem 0 0;
	background: var(--card-bg, #f3f0f7);
	color: var(--text-color, #1d1b20);
	box-shadow: 0 -8px 32px rgb(0 0 0 / 14%);
	transform: translate(-50%, 0);
	animation: update-sheet-enter 280ms cubic-bezier(.2, .8, .2, 1) both;
}
#pwa-update-toast[hidden] { display: none; }
.pwa-update-copy { display: grid; gap: .25rem; }
.pwa-update-copy strong { font-size: 1rem; font-weight: 600; }
.pwa-update-copy span { color: color-mix(in srgb, currentColor 72%, transparent); font-size: .875rem; }
.pwa-update-actions { display: flex; align-items: center; gap: .5rem; flex-shrink: 0; }
.pwa-update-actions button {
	padding: .55rem .85rem;
	border: 0;
	border-radius: 999px;
	background: var(--primary, #6750a4);
	color: white;
	cursor: pointer;
}
.pwa-update-actions button:last-child { background: transparent; color: inherit; }
.pwa-update-actions button:disabled { opacity: .65; cursor: wait; }
@media (max-width: 480px) {
	#pwa-update-toast { align-items: stretch; flex-direction: column; gap: 1rem; padding-inline: 1.25rem; }
	.pwa-update-actions { justify-content: flex-end; }
}
@media (prefers-reduced-motion: reduce) {
	.material-loader span, #pwa-update-toast { animation-duration: 3s; }
}
@keyframes update-sheet-enter { from { opacity: 0; transform: translate(-50%, 100%); } to { opacity: 1; transform: translate(-50%, 0); } }

@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
