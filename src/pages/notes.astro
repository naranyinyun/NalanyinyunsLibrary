---
import { getCollection, render } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const entries = await getCollection("notes", ({ data }) =>
	import.meta.env.PROD ? data.draft !== true : true,
);
const notes = await Promise.all(
	entries
		.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
		.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

function formatDate(date: Date) {
	return new Intl.DateTimeFormat("zh-CN", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}).format(date);
}
---

<MainGridLayout title="随笔" description="一些随手记录的想法与片段。">
	<div class="card-base px-6 py-8 md:px-10 md:py-10">
		<div class="mb-10 flex items-start justify-between gap-6">
			<div>
				<div class="mb-2 flex items-center gap-2 text-[var(--primary)]">
					<Icon name="material-symbols:edit-note-rounded" class="text-2xl" />
					<span class="text-sm font-bold tracking-[0.2em]">NOTES</span>
				</div>
				<h1 class="m-0 text-3xl font-bold text-90">随笔</h1>
				<p class="mt-3 mb-0 text-50">把路上遇到的念头，留在时间里。</p>
			</div>
			<div class="hidden rounded-full bg-[var(--btn-plain-bg-hover)] px-4 py-2 text-sm text-50 sm:block">
				{notes.length} 篇记录
			</div>
		</div>

		{notes.length > 0 ? (
			<div class="relative pl-6 md:pl-28">
				<div class="absolute left-[0.3rem] top-2 bottom-2 border-l-2 border-dashed border-[var(--line-color)] md:left-[6.3rem]"></div>
				{notes.map(({ entry, Content }) => (
					<article class="group relative mb-8 last:mb-0">
						<div class="absolute -left-[1.6rem] top-2 h-3 w-3 rounded-full border-[3px] border-[var(--card-bg)] bg-[var(--primary)] outline outline-1 outline-[var(--primary)] transition-transform group-hover:scale-125 md:-left-[1.1rem]"></div>
						<time datetime={entry.data.published.toISOString()} class="mb-2 block text-sm text-50 md:absolute md:-left-28 md:top-1 md:mb-0 md:w-20 md:text-right">
							{formatDate(entry.data.published)}
						</time>
						<div class="rounded-[var(--radius-large)] bg-[var(--btn-plain-bg-hover)] px-5 py-5 transition group-hover:-translate-y-0.5 group-hover:shadow-sm md:px-6">
							<h2 class="m-0 text-xl font-bold text-90">{entry.data.title}</h2>
							<div class="custom-md mt-4 text-75">
								<Content />
							</div>
							{entry.data.tags.length > 0 && (
								<div class="mt-4 flex flex-wrap gap-2">
									{entry.data.tags.map((tag) => <span class="rounded-full bg-[var(--card-bg)] px-2.5 py-1 text-xs text-50">#{tag}</span>)}
								</div>
							)}
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="rounded-[var(--radius-large)] bg-[var(--btn-plain-bg-hover)] px-6 py-12 text-center">
				<Icon name="material-symbols:edit-note-rounded" class="text-4xl text-[var(--primary)]" />
				<p class="mt-3 mb-1 font-bold text-90">还没有随笔</p>
				<p class="m-0 text-sm text-50">在 src/content/notes/ 中添加一篇 Markdown，就可以留下新的记录。</p>
			</div>
		)}
	</div>
</MainGridLayout>
