---
interface Props {
	index: number;
	organization: string;
	title: string;
	titleReading?: string;
}

const { index, organization, title, titleReading } = Astro.props;

const indexStr = String(index).padStart(2, "0");
---

<article class="title-card group relative isolate overflow-hidden rounded-[calc(var(--radius-large)-0.25rem)] border border-black/[0.08] bg-[var(--btn-regular-bg)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--primary)]/50 hover:shadow-[0_12px_28px_-18px_var(--primary)] dark:border-white/[0.1]">
  <div class="card-pattern pointer-events-none absolute inset-0 z-0 opacity-40 transition-opacity duration-300 group-hover:opacity-70 dark:opacity-25 dark:group-hover:opacity-45"></div>
  <div class="absolute inset-y-0 left-0 z-0 w-1 bg-gradient-to-b from-transparent via-[var(--primary)] to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>

  {titleReading && (
    <div class="title-reading-bg pointer-events-none absolute right-4 top-1/2 z-0 hidden select-none whitespace-nowrap font-serif text-6xl font-bold leading-none tracking-[0.18em] text-[var(--primary)]/[0.09] transition-colors duration-300 group-hover:text-[var(--primary)]/[0.16] sm:block dark:text-[var(--primary)]/[0.14] dark:group-hover:text-[var(--primary)]/[0.22]">
      {titleReading}
    </div>
  )}

  <div class="relative z-10 flex items-start gap-3 px-4 py-4 sm:items-center sm:gap-5 sm:px-6 sm:py-5">
    <div class="flex w-9 shrink-0 flex-col items-center pt-0.5 sm:w-10 sm:pt-0">
      <span class="font-mono text-[0.5625rem] font-medium uppercase leading-none tracking-[0.12em] text-black/45 dark:text-white/45">No.</span>
      <span class="mt-1 font-mono text-xl font-bold leading-none text-black/80 transition-colors duration-300 group-hover:text-[var(--primary)] dark:text-white/85 sm:text-2xl">{indexStr}</span>
    </div>

    <div class="mt-1 h-10 w-px shrink-0 bg-[var(--primary)]/25 transition-colors duration-300 group-hover:bg-[var(--primary)]/55 sm:mt-0"></div>

    <div class="min-w-0 flex-1">
      <div class="break-words text-[0.6875rem] font-medium leading-relaxed tracking-[0.08em] text-black/60 transition-colors duration-300 group-hover:text-black/80 dark:text-white/60 dark:group-hover:text-white/80 sm:text-xs sm:tracking-[0.12em]">
        {organization}
      </div>
      <div class="mt-1 text-sm font-bold leading-snug tracking-[0.08em] text-[var(--primary)] sm:text-base">
        {title}
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-4 right-4 z-10 h-px bg-gradient-to-r from-transparent via-[var(--primary)]/25 to-transparent transition-all duration-300 group-hover:via-[var(--primary)]/60 sm:left-6 sm:right-6"></div>
</article>

<style>
  .title-reading-bg {
    transform: translateY(-50%) skewX(-8deg) scaleX(0.95);
  }

  .card-pattern {
    background-image:
      repeating-linear-gradient(
        45deg,
        color-mix(in oklch, var(--primary) 35%, transparent) 0px,
        color-mix(in oklch, var(--primary) 35%, transparent) 1px,
        transparent 1px,
        transparent 16px
      ),
      repeating-linear-gradient(
        -45deg,
        color-mix(in oklch, var(--primary) 35%, transparent) 0px,
        color-mix(in oklch, var(--primary) 35%, transparent) 1px,
        transparent 1px,
        transparent 16px
      );
  }
</style>
