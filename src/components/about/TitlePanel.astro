---
import TitleCard from "./TitleCard.astro";

interface TitleEntry {
	organization: string;
	title: string;
	titleReading?: string;
}

interface Props {
	entries: TitleEntry[];
}

const { entries } = Astro.props;
---

<section class="title-panel card-base relative overflow-hidden border border-black/[0.08] bg-[var(--card-bg)] px-4 py-5 shadow-sm dark:border-white/[0.12] sm:px-7 sm:py-6">
  <div class="pointer-events-none absolute inset-0 opacity-40 dark:opacity-25 title-panel-pattern"></div>

  <header class="relative mb-5 flex items-center gap-2 sm:gap-3">
    <div class="h-px min-w-4 flex-1 bg-gradient-to-r from-transparent to-[var(--primary)]/40"></div>
    <div class="flex shrink-0 items-center gap-2 text-[var(--primary)]">
      <span class="h-1.5 w-1.5 rotate-45 bg-current opacity-70"></span>
      <span class="font-mono text-[0.625rem] font-semibold uppercase tracking-[0.18em] sm:text-xs sm:tracking-[0.3em]">Roles &amp; Titles</span>
      <span class="h-1.5 w-1.5 rotate-45 bg-current opacity-70"></span>
    </div>
    <div class="h-px min-w-4 flex-1 bg-gradient-to-l from-transparent to-[var(--primary)]/40"></div>
  </header>

  <div class="relative flex flex-col gap-3 sm:gap-4">
    {entries.map((entry, i) => (
      <TitleCard
        index={i + 1}
        organization={entry.organization}
        title={entry.title}
        titleReading={entry.titleReading}
      />
    ))}
  </div>

  <div class="relative mt-5 flex items-center gap-3" aria-hidden="true">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent to-[var(--primary)]/25"></div>
    <div class="h-1 w-1 rotate-45 bg-[var(--primary)]/50"></div>
    <div class="h-px flex-1 bg-gradient-to-l from-transparent to-[var(--primary)]/25"></div>
  </div>
</section>

<style>
  .title-panel-pattern {
    background-image: radial-gradient(circle at 1px 1px, var(--primary) 1px, transparent 0);
    background-size: 16px 16px;
    mask-image: linear-gradient(to bottom, black, transparent 78%);
  }
</style>
