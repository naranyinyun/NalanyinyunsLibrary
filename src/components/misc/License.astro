---
import { Icon } from "astro-icon/components";
import { licenseConfig, profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	class: string;
	author?: string;
	creationStatement?: string;
}

const { title, pubDate, author, creationStatement } = Astro.props;
const className = Astro.props.class;
const profileConf = profileConfig;
const licenseConf = licenseConfig;
const displayAuthor = author || profileConf.author || profileConf.name;
const postUrl = decodeURIComponent(Astro.url.toString());
---
<div class={`relative transition overflow-hidden bg-[var(--license-block-bg)] py-4 px-4 sm:py-5 sm:px-6 ${className}`}>
    <div class="relative z-10 min-w-0">
        <div class="transition font-bold text-black/75 dark:text-white/75 truncate">
            {title}
        </div>
        <a href={postUrl} class="link block max-w-full truncate text-[var(--primary)]" title={postUrl}>
            {postUrl}
        </a>
        <div class="relative grid grid-cols-2 gap-x-4 gap-y-3 mt-4 sm:flex sm:flex-wrap sm:gap-x-6 sm:gap-y-2">
            <div class="min-w-0">
                <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.author)}</div>
                <div class="transition text-black/75 dark:text-white/75 truncate">{displayAuthor}</div>
            </div>
            <div class="min-w-0">
                <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.publishedAt)}</div>
                <div class="transition text-black/75 dark:text-white/75 truncate">{formatDateToYYYYMMDD(pubDate)}</div>
            </div>
            <div class="min-w-0">
                <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.license)}</div>
                <a href={licenseConf.url} target="_blank" class="link block text-[var(--primary)] truncate" title={licenseConf.name}>{licenseConf.name}</a>
            </div>
            {creationStatement && <div class="min-w-0 col-span-2 sm:col-span-1">
                <div class="transition text-black/30 dark:text-white/30 text-sm">创作声明</div>
                <div class="transition text-black/75 dark:text-white/75 line-clamp-2">{creationStatement}</div>
            </div>}
        </div>
    </div>
    <Icon name="fa6-brands:creative-commons" class="transition text-[8rem] sm:text-[15rem] absolute pointer-events-none -right-4 sm:right-6 top-1/2 -translate-y-1/2 text-black/5 dark:text-white/5"></Icon>
</div>
